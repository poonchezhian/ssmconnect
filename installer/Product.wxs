<!--
  SSMConnect installer (WiX Toolset v3.x).
  Variables supplied by build-installer.ps1:
    Version, WizardExe, LicenseRtf, IconFile
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="SSMConnect"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Poonchezhian Periasamy"
           UpgradeCode="dcb4ac9b-a156-4f1a-aebc-83ec98ec8b7b">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="SSH over AWS Systems Manager for PuTTY, WinSCP and MobaXterm"
             Comments="Licensed under the Apache License 2.0" />

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of SSMConnect is already installed." />
    <!-- Hide the inner MSI from Settings > Apps so only the single setup entry is listed -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPCONTACT" Value="Poonchezhian Periasamy" />
    <Property Id="ARPHELPLINK" Value="https://github.com/poonchezhian/ssmconnect" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/poonchezhian/ssmconnect" />

    <!-- Windows version is checked by the setup window: Windows Installer reports the wrong version number to packages -->

    <!-- UI: Welcome -> License (Apache-2.0, must accept) -> Install folder -> Install -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <!-- Exit page: "Open the SSMConnect dashboard now" (ticked by default) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the SSMConnect dashboard now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <UIRef Id="WixUI_InstallDir" />

    <!-- Directory layout -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SSMConnect" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuDir" Name="SSMConnect" />
      </Directory>
    </Directory>

    <!-- Components -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="WizardComp" Guid="*">
        <File Id="WizardExe" Source="$(var.WizardExe)" Name="SSMConnect.Wizard.exe" KeyPath="yes" />
        <!-- Tray icon starts (hidden) at every sign-in so the tunnels start and the person can see their status -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="SSMConnect"
                       Type="string" Value="&quot;[INSTALLFOLDER]SSMConnect.Wizard.exe&quot; --tray" />
      </Component>
    </DirectoryRef>

    <!-- Start-menu shortcut (HKCU key path is the standard way to satisfy ICE43/ICE57) -->
    <DirectoryRef Id="AppMenuDir">
      <Component Id="ShortcutComp" Guid="a3c1f6d2-7b54-4e0a-9d38-5f2b8c6e1a47">
        <Shortcut Id="DashboardShortcut" Name="SSMConnect" Description="Dashboard: see and control your SSM connections"
                  Target="[INSTALLFOLDER]SSMConnect.Wizard.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallShortcut" Name="Uninstall SSMConnect" Description="Remove SSMConnect from this PC"
                  Target="[SystemFolder]msiexec.exe" Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SSMConnect" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="SSMConnect" Level="1" Absent="disallow">
      <ComponentRef Id="WizardComp" />
      <ComponentRef Id="ShortcutComp" />
    </Feature>

    <!-- Clean uninstall: remove "SSMConnect - *" sessions, saved settings and shortcuts of the installing user.
         Runs impersonated so HKCU and %APPDATA% are the user's, before the exe is deleted. Skipped on upgrade. -->
    <CustomAction Id="CleanupUserTools" FileKey="WizardExe" ExeCommand="--cleanup"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!-- Close a running dashboard / tray icon so files can be replaced or removed -->
    <util:CloseApplication Id="CloseDashboard" Target="SSMConnect.Wizard.exe" CloseMessage="no"
                           RebootPrompt="no" TerminateProcess="0" />

    <!-- Open the dashboard as the signed-in user (explorer.exe de-elevates), after the Finish button -->
    <CustomAction Id="LaunchDashboard" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]SSMConnect.Wizard.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Order="999" Event="DoAction" Value="LaunchDashboard">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>
    <InstallExecuteSequence>
      <Custom Action="CleanupUserTools" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
