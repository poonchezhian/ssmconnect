#!/usr/bin/env python3
import hashlib, json, os, socket, sys, time
a = sys.argv[1:]
def arg(name):
    return a[a.index(name) + 1] if name in a else None
def out(obj): print(json.dumps(obj))
if a[:2] == ["sso", "login"]:
    s = arg("--sso-session")
    d = os.path.expanduser("~/.aws/sso/cache"); os.makedirs(d, exist_ok=True)
    open(os.path.join(d, hashlib.sha1(s.encode()).hexdigest() + ".json"), "w").write(json.dumps(
        {"accessToken": "tok", "expiresAt": "2099-01-01T00:00:00Z", "startUrl": "x", "region": "us-east-1"}))
    print("Successfully logged into Start URL"); sys.exit(0)
if a[:2] == ["sso", "list-accounts"]:
    out([["111111111111", "Acme Prod"], ["222222222222", "Acme Dev"]]); sys.exit(0)
if a[:2] == ["sso", "list-account-roles"]:
    out(["Admin", "ReadOnly"]); sys.exit(0)
prof = arg("--profile") or ""
if a[:2] == ["ssm", "describe-instance-information"]:
    out([["i-0123456789abcdef0", "Online", "Linux", "Ubuntu"], ["i-0123456789abcdef1", "Online", "Windows", "Microsoft Windows Server 2022"]] if "Prod" in prof else []); sys.exit(0)
if a[:2] == ["ec2", "describe-instances"]:
    out([["i-0123456789abcdef0", "10.0.0.5", "web-prod-1", "prod-key", [{"Key": "Environment", "Value": "prd"}]],
         ["i-0123456789abcdef1", "10.0.0.6", "win-app", "prod-key", []],
         ["i-0123456789abcdef9", "10.0.0.7", "no-ssm", None, []]] if "Prod" in prof else []); sys.exit(0)
if a[:2] == ["ec2", "describe-key-pairs"]:
    out([["prod-key", os.environ.get("FAKE_FPR", "00:11")]]); sys.exit(0)
if "start-session" in a:
    port = int(arg("--parameters").split("localPortNumber=")[1])
    s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(("127.0.0.1", port)); s.listen(1)
    print("Waiting for connections...", flush=True); time.sleep(600)
sys.stderr.write("fake aws: unsupported " + " ".join(a) + "\n"); sys.exit(2)
