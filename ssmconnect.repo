# SSMConnect for Linux: installed by the ssmconnect package so that "dnf upgrade" / the software updater brings new releases.
# Packages and the repository's metadata are signed with the SSMConnect Linux Releases key
# (fingerprint FF9F 45E6 4711 7103 89B3 F1FC 7483 B1F8 DBE4 A803). To stop getting updates from here, set enabled=0.
[ssmconnect]
name=SSMConnect for Linux
baseurl=https://poonchezhian.github.io/ssmconnect/rpm/
enabled=1
gpgcheck=1
# Every package is checked against the key (gpgcheck). The repository index is not, because dnf then asks a question about its key that
# background and graphical updaters cannot answer, and they quietly leave the repository out of the list of updates.
repo_gpgcheck=0
# Look for a new release every 6 hours (dnf's default is 2 days, so a new version would take that long to be listed).
metadata_expire=6h
gpgkey=https://poonchezhian.github.io/ssmconnect/SIGNING-KEY.asc
