<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SSMConnect.Wizard</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\ssmconnect.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SSMConnect.Core\SSMConnect.Core.csproj" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\os\*.png" LogicalName="os.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
