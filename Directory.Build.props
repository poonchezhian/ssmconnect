<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Lets non-Windows machines (the CodeQL scan on GitHub) compile the Windows projects. No effect on normal Windows builds. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Poonchezhian Periasamy</Authors>
    <Product>SSMConnect</Product>
    <Copyright>Copyright 2026 @ Poonchezhian Periasamy</Copyright>
    <!-- Clean binaries: no debug symbols, no build-machine paths or user names, reproducible output -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/src/</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
